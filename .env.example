# ===== 飞书应用（机器人）=====
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret

# ===== DeepSeek（结构化抽取与分类）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 多维表格（由 npm run bootstrap 自动填写）=====
BITABLE_APP_TOKEN=
BITABLE_TABLE_ID=

# ===== Web 账本（手机访问）=====
PORT=7610
# 访问密钥：手机浏览器首次打开 http://<Mac的IP>:7610/?key=xxx
ACCESS_KEY=
